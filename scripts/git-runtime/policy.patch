+static void research_repo_config_policy(const char *key, const char *value,
+                                       const struct key_value_info *kvi)
+{
+	const char *policy = getenv("GIT_REPO_CONFIG_POLICY");
+	const char *global;
+	static const char * const structural[] = {
+		"core.repositoryformatversion", "core.filemode", "core.bare",
+		"core.logallrefupdates", "core.ignorecase", "core.precomposeunicode",
+		"extensions.worktreeconfig"
+	};
+	size_t i;
+
+	if (!policy)
+		return;
+	if (strcmp(policy, "structural-only-v1") && strcmp(policy, "executable-scope-v2") &&
+	    strcmp(policy, "mini-agent-executable-scope-v3-env"))
+		die("research config policy: unsupported mode");
+	global = getenv("GIT_CONFIG_GLOBAL");
+	if (!strcmp(policy, "mini-agent-executable-scope-v3-env")) {
+		const char *text = getenv("MINI_AGENT_GIT_GLOBAL_SNAPSHOT");
+		if (!text || strlen(text) > 65536 || !git_env_bool("GIT_CONFIG_NOSYSTEM", 0))
+			die("guarded Git: bounded captured global snapshot and NOSYSTEM required");
+		global = "mini-agent-owned-global-env-v1";
+	} else if (!global || !is_absolute_path(global) || !git_env_bool("GIT_CONFIG_NOSYSTEM", 0)) {
+		die("research config policy: explicit global snapshot and NOSYSTEM required");
+	}
+	/* Refuse expansion even from a global file: the fixture is flattened. */
+	if (!strcmp(key, "include.path") || starts_with(key, "includeif."))
+		die("research config policy: includes are forbidden");
+	if (!strcmp(policy, "executable-scope-v2") ||
+	    !strcmp(policy, "mini-agent-executable-scope-v3-env")) {
+		/* Scope alone cannot bless an explicitly selected --file/blob input.
+		 * Only this exact caller-owned flattened global file supplies code.
+		 * Normal -c parameters are separate trusted caller input, not files.
+		 */
+		if (kvi->scope == CONFIG_SCOPE_GLOBAL && kvi->filename &&
+		    !strcmp(kvi->filename, global) &&
+		    ((!strcmp(policy, "executable-scope-v2") && kvi->origin_type == CONFIG_ORIGIN_FILE) ||
+		     (!strcmp(policy, "mini-agent-executable-scope-v3-env") && kvi->origin_type == CONFIG_ORIGIN_CMDLINE)))
+			return;
+		if (research_executable_config_key(key, value))
+			die("research config policy: rejected untrusted executable key '%s'", key);
+		return;
+	}
+	if (kvi->scope != CONFIG_SCOPE_LOCAL && kvi->scope != CONFIG_SCOPE_WORKTREE)
+		return;
+	for (i = 0; i < ARRAY_SIZE(structural); i++)
+		if (!strcmp(key, structural[i]))
+			return;
+	/* Fail before any consumer sees the value, including unknown key names.
+	 * This deliberately rejects benign local preferences; no compatibility
+	 * or complete bead-acceptance claim may be made from this prototype.
+	 */
+	die("research config policy: rejected repository key '%s'", key);
+}
