+/* PRIVATE RESEARCH ONLY: intentionally restrictive compatibility probe.
+ * This is not an upstream policy or a production mini-agent boundary.
+ * The caller owns a flattened global snapshot; scope is not proof of trust.
+ */
+static int research_executable_config_key(const char *key, const char *value)
+{
+	static const char * const exact[] = {
+		"core.sshcommand", "core.askpass", "core.gitproxy", "core.alternaterefscommand",
+		"core.hookspath", "core.editor", "core.pager", "sequence.editor",
+		"diff.external", "gpg.program", "gpg.ssh.defaultkeycommand",
+		"interactive.difffilter", "gc.recentobjectshook", "uploadpack.packobjectshook",
+		"pull.twohead", "pull.octopus", "rebase.instructionformat",
+		"instaweb.httpd", "sendemail.smtpserver", "sendemail.tocmd", "sendemail.cccmd",
+		"sendemail.annotate", "sendemail.confirmcommand"
+	};
+	static const struct { const char *prefix; const char *suffix; } families[] = {
+		{ "filter.", ".clean" }, { "filter.", ".smudge" }, { "filter.", ".process" },
+		{ "diff.", ".command" }, { "diff.", ".textconv" }, { "merge.", ".driver" },
+		{ "credential.", ".helper" }, { "remote.", ".uploadpack" },
+		{ "remote.", ".receivepack" }, { "remote.", ".vcs" },
+		{ "gpg.", ".program" }, { "hook.", ".command" },
+		{ "trailer.", ".cmd" }, { "trailer.", ".command" },
+		{ "tar.", ".command" }, { "branch.", ".mergeoptions" },
+		{ "difftool.", ".cmd" }, { "difftool.", ".path" },
+		{ "mergetool.", ".cmd" }, { "mergetool.", ".path" },
+		{ "browser.", ".cmd" }, { "browser.", ".path" },
+		{ "man.", ".cmd" }, { "man.", ".path" }, { "guitool.", ".cmd" }
+	};
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(exact); i++)
+		if (!strcmp(key, exact[i]))
+			return 1;
+	for (i = 0; i < ARRAY_SIZE(families); i++)
+		if (starts_with(key, families[i].prefix) && ends_with(key, families[i].suffix))
+			return 1;
+	if (starts_with(key, "alias."))
+		return 1;
+	if (!strcmp(key, "core.fsmonitor") || starts_with(key, "pager."))
+		return git_parse_maybe_bool(value) < 0;
+	if (starts_with(key, "submodule.") && ends_with(key, ".update"))
+		return value && value[0] == '!';
+	return 0;
+}
