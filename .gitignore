/target/
.DS_Store
*.swp
*.orig
__pycache__/
*.py[cod]

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Codex workspace-local home (seeded by loop.sh when using codex executor)
.codex/
.worktrees
.context/

# Model cache downloaded by fastembed at runtime
.fastembed_cache/

# Local tool and runtime state that must never enter the crate archive.
# `.claude/coderlm_state/coderlm_cli.py` is an absolute symlink into the
# user's plugin cache, which made `cargo package` fail on CI.
.claude/coderlm_state/
.coderlm/
.zerostack/

# Default Skill Gym root: episode worktrees and per-arm AppPaths trees.
# Override with MINI_AGENT_GYM_ROOT to place it outside the repository.
.gym/
