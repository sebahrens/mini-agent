<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>mini-agent-windows-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</RepositoryRoot>
    <DefineConstants>BinaryPath=$(BinaryPath);VsixPath=$(VsixPath);ThirdPartyLicensesPath=$(ThirdPartyLicensesPath);ProductVersion=$(ProductVersion);RepositoryRoot=$(RepositoryRoot)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>

  <Target Name="RequireInstallerInputs" BeforeTargets="BeforeBuild">
    <Error Condition="'$(ProductVersion)' == ''" Text="ProductVersion is required." />
    <Error Condition="'$(BinaryPath)' == '' Or !Exists('$(BinaryPath)')" Text="BinaryPath must name mini-agent.exe." />
    <Error Condition="'$(VsixPath)' == '' Or !Exists('$(VsixPath)')" Text="VsixPath must name the win32-x64 VSIX." />
    <Error Condition="'$(ThirdPartyLicensesPath)' == '' Or !Exists('$(ThirdPartyLicensesPath)')" Text="ThirdPartyLicensesPath must name the release archive's THIRD_PARTY_LICENSES." />
  </Target>
</Project>
