{
  "schema_version": "1.0",
  "agent": {
    "name": "mini-agent",
    "version": "1.8.0",
    "description": "Minimalistic coding agent with built-in JS engine",
    "homepage": "https://github.com/sebahrens/mini-agent",
    "protocol": {
      "name": "agent-client-protocol",
      "version": "1.3.0",
      "schema_version": "1.5.0",
      "transports": ["stdio", "tcp"]
    },
    "capabilities": {
      "sessions": {
        "max_concurrent": 64,
        "close": true
      },
      "permissions": {
        "interactive": true,
        "request_permission": true
      },
      "tools": [
        "bash",
        "read",
        "write",
        "edit",
        "list_dir",
        "git"
      ]
    },
    "startup": {
      "stdio": {
        "command": "mini-agent",
        "args": ["--acp"]
      },
      "tcp": {
        "command": "mini-agent",
        "args": ["--acp-port", "${port}"],
        "notes": "TCP authentication uses api_key under [acp_servers.<name>] in the mini-agent config (the --api-key flag is the model-provider key, not ACP auth). See docs/vscode-acp-setup.md."
      }
    }
  }
}
