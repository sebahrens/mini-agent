{
  "schema_version": "1.0",
  "agent": {
    "name": "mini-agent",
    "version": "1.7.2",
    "description": "Minimalistic coding agent with built-in JS engine",
    "homepage": "https://github.com/sebahrens/mini-agent",
    "protocol": {
      "name": "agent-client-protocol",
      "version": "1.3.0",
      "schema_version": "1.5.0",
      "transports": ["stdio", "tcp"]
    },
    "capabilities": {
      "sessions": {
        "max_concurrent": 64,
        "close": true
      },
      "permissions": {
        "interactive": true,
        "request_permission": true
      },
      "tools": [
        "bash",
        "read_file",
        "write_file",
        "edit_file",
        "list_directory",
        "git"
      ]
    },
    "startup": {
      "stdio": {
        "command": "mini-agent",
        "args": ["--acp"]
      },
      "tcp": {
        "command": "mini-agent",
        "args": ["--acp-port", "${port}"],
        "notes": "Requires --api-key configuration. See docs/vscode-acp-setup.md."
      }
    }
  }
}
