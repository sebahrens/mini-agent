+        let state = root.path().join("state");
+        crate::fs::ensure_private_directory(&state).unwrap();
+        let writer = Ledger::new(&state);
+        flush_receipt(&writer, &one_receipt("a", 10)).unwrap();
+        let (scanned_tx, scanned_rx) = std::sync::mpsc::sync_channel(1);
+        let (released_tx, released_rx) = std::sync::mpsc::sync_channel(1);
+        let reader = Ledger::new(&state).with_summary_gate(scanned_tx, released_rx);
+        let reading = std::thread::spawn(move || reader.session_summary("a"));
+        scanned_rx.recv_timeout(std::time::Duration::from_secs(3)).unwrap();
+        let (file, binding) = writer.open(true).unwrap().unwrap();
+        writer.lock_writer(&binding, &file).unwrap();
+        let mut file = LockedLedgerFile::new(file);
+        writer.rotate(&binding, &mut file).unwrap();
+        drop(file);
+        released_tx.send(()).unwrap();
+        let summary = reading.join().unwrap().unwrap();
+        assert_eq!(summary.session.records, 1, "one receipt must not count in both snapshot and rollup");
+    }
