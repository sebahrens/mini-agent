+#[tokio::test]
+async fn release_review_probe_search_keeps_outcomes_linked_to_earlier_invocations() {
+    use crate::agent::runner::TaskOutcomeRecorder;
+    use crate::extras::js::skills::turn::SkillRuntime;
+    use std::sync::Arc;
+    let (root, store, skill) = fixture();
+    let runtime = SkillRuntime::open(&paths(&root), None).unwrap();
+    runtime.settle_learned_rebuild_for_test().await;
+    runtime.prepare_turn("Retention fixture").await;
+    let initial = runtime.turn_context().snapshot();
+    assert!(initial.skills.iter().any(|s| s.id == skill.id));
+    let dispatcher = Arc::new(TelemetryDispatcher::spawn(&paths(&root)).unwrap());
+    let invocation = stable_invocation_id(&initial.turn_id, "review-tool", &skill.id, "run", 0);
+    let event = |kind, outcome, latency| SkillEvent {
+        invocation_id: Some(invocation.clone()),
+        skill_id: skill.id.clone(),
+        turn_id: initial.turn_id.clone(),
+        tool_call_id: Some("review-tool".into()),
+        kind,
+        export_name: Some("run".into()),
+        outcome,
+        latency_us: latency,
+        retrieval_score: Some(1.0),
+        retrieval_rank: Some(0),
+        query_fingerprint: None,
+        index_generation: 0,
+        evidence_complete: true,
+        production: true,
+        argument_shape: None,
+        created_at: 2_000_000_000,
+    };
+    dispatcher
+        .try_dispatch(
+            EventBatch::new(vec![
+                event(SkillEventKind::Invoked, None, None),
+                event(SkillEventKind::Returned, Some("fulfilled".into()), Some(5)),
+            ])
+            .unwrap(),
+        )
+        .unwrap();
+    runtime.refreeze_turn("zxqjvnmoplk unrelated").await;
+    let final_bundle = runtime.turn_context().snapshot();
+    assert_eq!(initial.turn_id, final_bundle.turn_id);
+    assert!(final_bundle.skills.is_empty());
+    let recorder = TaskOutcomeRecorder::new(dispatcher.clone(), runtime.turn_context(), true);
+    recorder.record_oracle("review-oracle", true, 1);
+    drop((recorder, dispatcher));
+    let deadline = Instant::now() + Duration::from_secs(2);
+    loop {
+        let count: i64 = store
+            .conn()
+            .query_row(
+                "SELECT COUNT(*) FROM skill_task_outcomes WHERE turn_id=?",
+                [&initial.turn_id],
+                |r| r.get(0),
+            )
+            .unwrap();
+        if count > 0 {
+            break;
+        }
+        assert!(Instant::now() < deadline, "outcome must persist");
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+    let links: i64 = store
+        .conn()
+        .query_row(
+            "SELECT COUNT(*) FROM skill_task_outcome_links WHERE skill_id=?",
+            [&skill.id],
+            |r| r.get(0),
+        )
+        .unwrap();
+    drop((runtime, store));
+    let _ = std::fs::remove_dir_all(root);
+    assert_eq!(
+        links, 1,
+        "skills_search erased attribution for a skill invoked earlier in the same turn"
+    );
+}
