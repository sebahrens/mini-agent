+#[test]
+fn release_review_probe_pending_index_generation_does_not_drop_immediate_quarantine() {
+    use crate::extras::js::skills::coordinator::IndexCoordinator;
+    use crate::extras::js::skills::embed::Embedder;
+    use std::sync::Arc;
+    let (root, mut store, skill) = fixture();
+    let embedder = Arc::new(Embedder::new().unwrap());
+    let model = embedder.model_metadata().clone();
+    let coordinator = Arc::new(IndexCoordinator::open(&paths(&root), embedder).unwrap());
+    coordinator.rebuild_and_publish().unwrap();
+    let dispatcher = TelemetryDispatcher::spawn_session_scoped_with_coordinator(
+        &paths(&root),
+        coordinator.clone(),
+    )
+    .unwrap();
+    store
+        .request_generation(
+            &model.model_id,
+            &model.model_revision,
+            model.dimensions,
+            model.normalized,
+        )
+        .unwrap();
+    let state = store.generation_state().unwrap();
+    assert!(state.desired_generation > state.applied_generation);
+    let invocation = stable_invocation_id("review-quarantine", "tool", &skill.id, "run", 0);
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap()
+        .as_secs() as i64;
+    let event = |kind| SkillEvent {
+        invocation_id: Some(invocation.clone()),
+        skill_id: skill.id.clone(),
+        turn_id: "review-quarantine".into(),
+        tool_call_id: Some("tool".into()),
+        kind,
+        export_name: Some("run".into()),
+        outcome: None,
+        latency_us: None,
+        retrieval_score: None,
+        retrieval_rank: None,
+        query_fingerprint: None,
+        index_generation: state.applied_generation,
+        evidence_complete: true,
+        production: true,
+        argument_shape: None,
+        created_at: now,
+    };
+    dispatcher
+        .try_dispatch(
+            EventBatch::new(vec![
+                event(SkillEventKind::Invoked),
+                event(SkillEventKind::CapabilityDenied),
+            ])
+            .unwrap(),
+        )
+        .unwrap();
+    drop(dispatcher);
+    coordinator.rebuild_and_publish().unwrap();
+    let status = store.metadata(&skill.id).unwrap().unwrap().status;
+    let visible = coordinator.lease().unwrap().contains_id(&skill.id);
+    drop((coordinator, store));
+    let _ = std::fs::remove_dir_all(root);
+    assert_eq!(
+        status, "quarantined",
+        "the only safety event was dropped while index publication was pending; visible_after_rebuild={visible}"
+    );
+}
