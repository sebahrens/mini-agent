+#[test]
+fn release_review_probe_telemetry_shutdown_does_not_wait_for_external_writer() {
+    let (root, store, skill) = fixture();
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .unwrap();
+    let dispatcher = runtime.block_on(async {
+        TelemetryDispatcher::spawn_with_busy_timeout_for_test(
+            &paths(&root),
+            Duration::from_millis(1),
+        )
+        .unwrap()
+    });
+    let lock = rusqlite::Connection::open(store.database_path()).unwrap();
+    lock.execute_batch("BEGIN IMMEDIATE").unwrap();
+    dispatcher
+        .try_dispatch(
+            EventBatch::new(vec![SkillEvent {
+                invocation_id: None,
+                skill_id: skill.id,
+                turn_id: "review-shutdown".into(),
+                tool_call_id: None,
+                kind: SkillEventKind::Selected,
+                export_name: None,
+                outcome: None,
+                latency_us: None,
+                retrieval_score: None,
+                retrieval_rank: None,
+                query_fingerprint: None,
+                index_generation: 0,
+                evidence_complete: true,
+                production: true,
+                argument_shape: None,
+                created_at: 2_000_000_000,
+            }])
+            .unwrap(),
+        )
+        .unwrap();
+    let deadline = Instant::now() + Duration::from_secs(2);
+    while dispatcher.busy_retries_for_test() == 0 && Instant::now() < deadline {
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    assert!(dispatcher.busy_retries_for_test() > 0);
+    runtime.block_on(async { drop(dispatcher) });
+    let unlocker = std::thread::spawn(move || {
+        std::thread::sleep(Duration::from_millis(700));
+        lock.execute_batch("ROLLBACK").unwrap();
+    });
+    let started = Instant::now();
+    drop(runtime);
+    let elapsed = started.elapsed();
+    unlocker.join().unwrap();
+    drop(store);
+    let _ = std::fs::remove_dir_all(root);
+    assert!(
+        elapsed < Duration::from_millis(300),
+        "runtime teardown waited {elapsed:?} for a separate SQLite writer"
+    );
+}
