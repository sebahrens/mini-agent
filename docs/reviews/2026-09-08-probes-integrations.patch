+#[test]
+fn release_review_probe_long_fence_parsing_is_linear() {
+    let mut feed = Feed::new();
+    feed.push_streaming_block(BlockStyle::Agent);
+    feed.append_to_last("```rust\n");
+    let mut total = 8;
+    for _ in 0..1000 {
+        let line = "let value = 12345;\n";
+        total += line.len();
+        feed.append_to_last(line);
+        let _ = feed.lines(100);
+    }
+    assert!(feed.markdown_bytes_parsed() < total * 10,
+        "{} bytes parsed for {} source bytes", feed.markdown_bytes_parsed(), total);
+}
+#[test]
+fn release_review_probe_long_fence_delimiter_streaming_matches_final_render() {
+    let mut feed = Feed::new();
+    feed.push_streaming_block(BlockStyle::Agent);
+    feed.append_to_last("````text\nliteral\n```\n\n");
+    let _ = feed.lines(100);
+    feed.append_to_last("# literal header\n");
+    let streamed: Vec<_> = feed.lines(100).iter().map(|line| line.text.to_string()).collect();
+    feed.finalize_last();
+    let finalized: Vec<_> = feed.lines(100).iter().map(|line| line.text.to_string()).collect();
+    assert_eq!(streamed, finalized);
+}
