+#[tokio::test]
+async fn release_review_probe_lsp_stalled_writer_is_bounded() {
+    let fixture = FixtureBuild::compile("review-stalled-writer");
+    let workspace = fixture.workspace("workspace");
+    let lease = fixture.path("stalled.lease");
+    let cfg = fixture.config("review-stop-reading", &lease);
+    let client = spawn_client(&cfg, &workspace, Duration::from_secs(2)).await.unwrap();
+    let pid = wait_for_pid(&lease).await;
+    let result = tokio::time::timeout(Duration::from_millis(500),
+        client.sync_text(&workspace.join("file.probe"), "x".repeat(1024 * 1024))).await;
+    client.shutdown().await;
+    assert_process_reaped(pid).await;
+    fixture.cleanup();
+    assert!(result.is_ok(), "stalled LSP stdin held document synchronization until external cancellation");
+}
