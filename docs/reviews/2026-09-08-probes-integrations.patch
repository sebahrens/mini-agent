+#[tokio::test]
+async fn release_review_probe_mcp_generated_names_cannot_collide() {
+    let fixture = FixtureBuild::compile();
+    let mut handles = Vec::new();
+    for (server, name) in [("alpha", "probe"), ("beta", "probe"), ("gamma", "alpha__probe")] {
+        let lease = fixture.lease(server);
+        handles.push(McpClientHandle::connect(CompactString::new(server),
+            &fixture.config(fixture.executable.display().to_string(), vec![name.into()], "named", &lease)).await.unwrap());
+    }
+    let manager = McpClientManager::from_handles(handles);
+    let tools = manager.collect_tools(None, None).await;
+    let names: Vec<_> = tools.iter().map(|t| t.name()).collect();
+    let unique: std::collections::HashSet<_> = names.iter().collect();
+    let unique_count = unique.len();
+    shutdown(manager).await;
+    fixture.cleanup();
+    assert_eq!(unique_count, names.len(), "duplicate registered names: {names:?}");
+}
+#[tokio::test]
+async fn release_review_probe_mcp_preserves_structured_only_result() {
+    let fixture = FixtureBuild::compile();
+    let lease = fixture.lease("structured");
+    let handle = McpClientHandle::connect(CompactString::new("fixture"),
+        &fixture.config(fixture.executable.display().to_string(), vec![], "structured-only", &lease)).await.unwrap();
+    let manager = McpClientManager::from_handles(vec![handle]);
+    let tools = manager.collect_tools(Some(permission_for(Action::Allow)), None).await;
+    let output = tools[0].call("{}".into()).await.unwrap();
+    shutdown(manager).await;
+    fixture.cleanup();
+    assert!(output.contains("42"), "structured result lost: {output:?}");
+}
