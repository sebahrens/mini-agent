+#[test]
+fn release_review_probe_one_bad_session_does_not_hide_healthy_sessions() {
+    let env = setup_test_env();
+    let s = Session::new("openai", "gpt-4", 128000, "");
+    save_session(&s).unwrap();
+    std::os::unix::fs::symlink(env.dir.join("missing"), env.dir.join("sessions/broken.json")).unwrap();
+    let result = find_sessions_by_prefix(&s.id);
