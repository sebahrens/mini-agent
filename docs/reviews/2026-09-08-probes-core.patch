+#[cfg(test)]
+mod release_review_probes {
+    use super::*;
+    #[test]
+    fn release_review_probe_guarded_replacement_preserves_concurrent_in_place_edit() {
+        let root = std::env::temp_dir().join(format!("review-stale-{}", uuid::Uuid::new_v4()));
+        std::fs::create_dir(&root).unwrap();
+        let root = std::fs::canonicalize(root).unwrap();
+        let path = root.join("file.txt");
+        std::fs::write(&path, "old contents").unwrap();
+        let binding = WorkspaceBinding::capture(&root).unwrap();
+        let opened = binding.open_relative(Path::new("file.txt")).unwrap();
+        let expected = crate::fs::checked_file_metadata(&opened).unwrap();
+        std::fs::write(&path, "concurrent user change").unwrap();
+        let result = binding.replace_relative_atomic(Path::new("file.txt"), b"agent edit based on old contents", &expected);
+        let actual = std::fs::read_to_string(&path).unwrap();
+        std::fs::remove_dir_all(&root).unwrap();
+        assert!(result.is_err(), "stale replacement succeeded and persisted {actual:?}");
+    }
+}
