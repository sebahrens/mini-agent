+    #[tokio::test]
+    async fn release_review_probe_edit_obeys_default_file_size_limit() {
+        let root = std::env::temp_dir().join(format!("review-edit-size-{}", uuid::Uuid::new_v4()));
+        std::fs::create_dir(&root).unwrap();
+        let path = root.join("large.txt");
+        std::fs::write(&path, format!("needle\n{}", "x".repeat(2 * 1024 * 1024))).unwrap();
+        let tool = EditTool::new(None, None).with_workspace(root.clone());
+        let result = tool.call(EditArgs { path: "large.txt".into(), replace_all: false,
+            block: Some("<<<<<<< SEARCH\nneedle\n=======\nreplacement\n>>>>>>> REPLACE".into()),
+            file_crc: None, edits: None }).await;
+        std::fs::remove_dir_all(&root).unwrap();
+        assert!(result.is_err(), "edit bypassed default 1 MiB file limit: {result:?}");
+    }
+}
