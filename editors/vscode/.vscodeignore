# Exclude everything by default, then re-include what's needed
**
!dist/**
!media/**
!package.json
!LICENSE

# Source and dev files
src/
node_modules/
.vscode/
*.map
tsconfig.json
.eslintrc*

# Platform binaries: exclude all, re-include the target platform in CI
# bin/
# !bin/win32-x64/**   # uncomment for win32-x64 package
# !bin/darwin-arm64/** # uncomment for darwin-arm64 package
# !bin/linux-x64/**   # uncomment for linux-x64 package
