# Exclude everything by default, then re-include what's needed
**
!dist/**
!package.json
!LICENSE
!THIRD_PARTY_LICENSES.md
!THIRD_PARTY_APACHE_LICENSE.txt
!SOURCE.md

# Source and dev files
src/
node_modules/
.vscode/
*.map
tsconfig.json
.eslintrc*
test/
scripts/
package-lock.json

# Platform binaries are excluded for bare vsce commands. package-target.mjs
# generates a target-specific ignore file that re-includes exactly one binary.
bin/**
