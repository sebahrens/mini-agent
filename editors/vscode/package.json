{
  "name": "mini-agent",
  "displayName": "Mini Agent",
  "description": "Mini Agent — AI coding agent with ACP stdio integration",
  "version": "1.8.0",
  "publisher": "mini-agent",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebahrens/mini-agent.git"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20.0.0"
  },
  "categories": ["AI", "Chat", "Other"],
  "extensionKind": ["workspace", "ui"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "mini-agent.chat",
        "name": "mini-agent",
        "fullName": "Mini Agent",
        "description": "Work with Mini Agent in the current trusted workspace.",
        "isSticky": true
      }
    ],
    "commands": [
      {
        "command": "mini-agent.start",
        "title": "Mini Agent: Start Session"
      },
      {
        "command": "mini-agent.stop",
        "title": "Mini Agent: Stop Session"
      },
      {
        "command": "mini-agent.restart",
        "title": "Mini Agent: Restart Session"
      },
      {
        "command": "mini-agent.selectFolder",
        "title": "Mini Agent: Select Workspace Folder"
      },
      {
        "command": "mini-agent.openConfig",
        "title": "Mini Agent: Open Config"
      },
      {
        "command": "mini-agent.showOutput",
        "title": "Mini Agent: Show Output"
      }
    ],
    "configuration": {
      "title": "Mini Agent",
      "properties": {
        "mini-agent.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the mini-agent executable. Leave empty to use the bundled artifact.",
          "scope": "machine"
        },
        "mini-agent.logLevel": {
          "type": "string",
          "enum": ["error", "warn", "info", "debug", "trace"],
          "default": "info",
          "description": "Log verbosity for the mini-agent output channel.",
          "scope": "machine"
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Mini Agent can read files and execute tools; workspace must be trusted."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Mini Agent requires a real file system and cannot operate in virtual workspaces."
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify",
    "dev": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:integration": "node ./scripts/run-integration-tests.mjs",
    "package": "vsce package",
    "package:win32-x64": "node ./scripts/package-target.mjs win32-x64",
    "package:darwin-x64": "node ./scripts/package-target.mjs darwin-x64",
    "package:darwin-arm64": "node ./scripts/package-target.mjs darwin-arm64",
    "package:linux-x64": "node ./scripts/package-target.mjs linux-x64",
    "package:linux-arm64": "node ./scripts/package-target.mjs linux-arm64",
    "sbom": "node ./scripts/generate-sbom.mjs"
  },
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "@types/node": "20.17.30",
    "@types/vscode": "1.90.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.21.5",
    "eslint": "8.57.1",
    "fflate": "0.8.2",
    "typescript": "5.4.5",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "zod": "4.4.3"
  }
}
